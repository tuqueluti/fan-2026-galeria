# Chave de API do Google Cloud com a Google Drive API v3 ativada.
# Usada EXCLUSIVAMENTE pelos scripts Node.js em desenvolvimento/build (npm run sync).
# NUNCA use o prefixo VITE_ nesta variável para que ela jamais entre no bundle público.
GOOGLE_DRIVE_API_KEY=COLE_AQUI_SUA_GOOGLE_DRIVE_API_KEY

# Opcional: limite de downloads/processamentos simultâneos de prévias no build (1 a 8, padrão: 4)
SYNC_CONCURRENCY=4
